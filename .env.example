# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Model used for extraction (haiku is fast/cheap and plenty for structured extraction)
LLM_MODEL=claude-haiku-4-5-20251001

# Defaults to a local SQLite file; point at a Postgres URL in production
# e.g. postgresql+psycopg2://user:pass@localhost:5432/documents
DATABASE_URL=sqlite:///./documents.db
